    {
      "id": "K-R2-EE2",
      "work": "Enten–Eller. Anden del",
      "url": "https://tekster.kb.dk/text/sks-ee2-txt-root",
      "author_voice": "B/法官威廉书信，假名编辑框架",
      "read_scope": "p221–224/258–262/272，SKS213–215/236–240/245–246"
    }
  ],
  "argument_chains": [
    {
      "title": "选择自我不是制造空白的自己",
      "locator": "EE2 p221–224，SKS213–215",
      "premise": "选择者已有具体性格、经历与差异，不从一个无内容自我开始。",
      "reasoning": "选择改变的是对既有具体生活的承担；人仍有原来细节，却因主动承担而改变关系。随后的善恶与悔改讨论说明，承担不等于肯定所有过去行为。",
      "limit": "这是B的伦理立场，不能用“我选择了”替伤害免责，也不是宣称人凭意志创造所有条件。"
    },
    {
      "title": "具体关系与抽象逃离",
      "locator": "EE2 p258–262，SKS236–240",
      "premise": "只把有限世界看作虚妄，可能使个人停在抽象孤立中。",
      "reasoning": "文本把伦理悔改的动作写成消除或承担其对象，而不是一走了之；选择应回到具体世界。在p261，它明确以初恋与宗教激情相类比，追问一度有过强烈时刻之后，持续生活有什么意义。",
      "limit": "这些宗教描绘是B对神秘者的批评，不能代表所有基督教论述，更不能据此取消Anti-Climacus的超越关系。"
    },
    {
      "title": "自我是连续任务",
      "locator": "EE2 p262/272，SKS239–240/245–246",
      "premise": "个体具有天赋、环境和经历构成的具体差异。",
      "reasoning": "把这些条件接纳为需要负责的任务，而不是可随意玩弄的可能性；在既成条件中采取行动，使历史具有连续性。",
      "limit": "这支持伦理形成领域，仍不足证明《致死的疾病》的完整关系公式跨域复现。"
    },
    {
      "title": "使人注意与使人信服不同",
      "locator": "署名SFV p85–86，SKS32",
      "premise": "受助者是否接受一个信念，仍涉及他自己的意愿。",
      "reasoning": "作者区分引起注意、促使判断和决定其判断内容。使对方注意之后，他可能判断相反，甚至敌视传播者；方法承担这种风险。",
      "limit": "这里的强迫注意不是强迫信仰，更不是操控、欺骗他人的现代许可；作者论殉道不等于劝人寻求伤害。"
    }
  ],
