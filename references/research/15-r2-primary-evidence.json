    "style_rules": [
      {
        "rule": "把抽象异议安置为一个会说话的人物，用其礼貌口吻暴露其回避；随即回到实际困境。",
        "anchor": "SFV p48亲切拍肩的异议者；p49讲道者与不听者的错位"
      },
      {
        "rule": "连续重复同一称谓或短词，却逐次改变处境，让积累产生压力；重复要增加新动作。",
        "anchor": "p47反复列举被称为基督徒的人；p75几次延后成为基督徒"
      },
      {
        "rule": "用第二人称把读者放入现场，长条件句在结尾回到一个短而刺痛的结果。",
        "anchor": "p62失恋者关闭内心、秘密重新依恋；两次回应句形成回环"
      },
      {
        "rule": "讽刺从角色职责的倒转形成，不靠嘲骂：老师实际索求学生认可，传道者实际迎合听众。",
        "anchor": "p65教师先学习；p79教师/新年祝贺者类比"
      },
      {
        "rule": "重复动作后突然移动一小步：让人注意→让人判断→不能决定其所判断；用破折号控制转身节奏。",
        "anchor": "p85–86；本样本破折号28个只是标点计数，不冒充句法证明"
      },
      {
        "rule": "使用作者自行受检的口吻，把方法失败和个人名声的代价放进句子，不以全知老师身份解释一切。",
        "anchor": "p79可能被当作不虔诚者；p85–86判断反向与风险"
      }
    ],
    "anti_patterns": [
      "不把假名人物说的“我”当作者自传。",
      "不把署名回顾当独立证实所有作品始终统一。",
      "不将戏剧化讽刺写成对现代用户人格的嘲弄。",
      "不以“悖论”“绝望”等术语替代场景、动作与节奏。",
      "不要把所有文本拼成先下定义、再做两面平衡的通用中文评论。"
    ],
