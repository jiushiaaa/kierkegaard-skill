  "sources": [
    {
      "title": "署名《我的著述活动的观点》",
      "url": "https://tekster.kb.dk/text/sks-sfv-txt-root",
      "actual_reading": "p47–100范围内固定抽样20个完整正文自然段全部实读；p59是小节标题，已排除重抽。新增连续p62–67、p85–86等由本轮和既读段构成。",
      "version": "丹麦王家图书馆SKS电子版；1848写作、1859身后出版。SKS页23–36，网页p编号加element_id与哈希复核。"
    },
    {
      "title": "《非此即彼》第二部",
      "url": "https://tekster.kb.dk/text/sks-ee2-txt-root",
      "actual_reading": "连续p221–224、258–262，另p272完整；对应SKS页213–215、236–240、245–246。",
      "version": "1843，B的书信/法官威廉声音，Victor Eremita编辑框架；丹麦文SKS校訂文本。不要与署名作者或Anti-Climacus自动合并。"
    }
  ],
  "source_catalog_delta": [
    {
      "id": "K-R2-SFV",
      "work": "Synspunktet for min Forfatter-Virksomhed",
